*.db
*.sqlite3
backend/app/db/nexora.db

# Build Artifacts & Logs
dist/
frontend/dist/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sandboxes & Disposable Runtime Clones
backend/sandboxes/
backend/disposable_repos/

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

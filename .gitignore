# Dependencies & Virtual Environments
node_modules/
frontend/node_modules/
.venv/
venv/
env/
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Environment & Secrets
.env
.env.*
.env.local
backend/.env
backend/.env.*
*.env
!.env.example


# ==============================================================================
# NEXORA Code — Environment Configuration Template
# Problem Statement PS 01: Coding Agent That Gets the Job Done on Fewest Tokens
# Team: TEAM ARISE | Global AI Hackathon 2026
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary AI Model Engine: Google Gemini API
# ------------------------------------------------------------------------------
# Obtain API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ------------------------------------------------------------------------------
# 2. Technology Partner Gateway: Bifrost by Maxim AI (Optional / Client Preserved)
# ------------------------------------------------------------------------------
# When BIFROST_API_KEY is configured, the router can route requests through the
# Bifrost AI Gateway proxy. If left blank, direct Gemini API routing is used.
BIFROST_API_KEY=
BIFROST_BASE_URL=https://api.maxim.ai/bifrost/v1

# ------------------------------------------------------------------------------
# 3. Secondary Failover Engine: DeepSeek V3 (Optional)
# ------------------------------------------------------------------------------
# OpenAI-compatible API key for secondary failover when Gemini hits rate limits (HTTP 429)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ------------------------------------------------------------------------------
# 4. Local Model Configuration: Ollama (Confidential Mode / Local-Only Routing)
# ------------------------------------------------------------------------------
# Local Ollama endpoint for privacy-sensitive and confidential repository tasks.
# If Ollama is offline or unreachable, confidential requests safely fail closed.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# ------------------------------------------------------------------------------
# 5. Testing & Verification Modes
# ------------------------------------------------------------------------------
# Set to 1 to run offline automated tests without external network or API calls
# NEXORA_TEST_MOCK_LLM=1

# ------------------------------------------------------------------------------
# 6. Server & Deployment Configuration
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
